<section class="page-banner">
  <div class="container">
    <div class="page__head">
      <h1>Alumni services</h1>
    </div>
  </div>
</section>

<section class="page alumni-services">
  <div class="container">

    <div class="page__section split">
      <h2>Looking for a mentor?</h2>
      <div class="prose">
        <p>
          Are you a person who wants to connect with a Mentor? Tibetan Scholarship Alumni Association is a strong
          network of TSP alumni across the world in equally diverse fields. We have Tibetan mentors that are
          supportive individuals who will offer guidance and encouragement to help set academic and/or career
          goals and taking steps to achieve them.
        </p>
        <p>
          Fill the form with your details and we will try our best to connect you to the mentor of your choice.
        </p>
        <div class="actions">
          <a class="btn" href="https://forms.gle/eoe9v9Em7PHeDKFMA">Fill in the mentor form</a>
        </div>
      </div>
    </div>

    <div class="page__section split">
      <h2>Services and resources</h2>
      <ul class="resource-list" role="list">
        <% for (postName in public.services._data) { var sv = public.services._data[postName]; %>
        <li>
          <a href="<%= sv.link %>">
            <span class="resource-list__topic"><%= sv.topics %>, <%= sv.month %> <%= sv.year %></span>
            <span class="resource-list__title"><%= sv.title %></span>
          </a>
        </li>
        <% } %>
      </ul>
    </div>
  </div>
</section>
